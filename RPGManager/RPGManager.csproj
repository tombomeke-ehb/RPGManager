<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0-dev</InformationalVersion>
    <Authors>Tombomeke Studios</Authors>
    <RepositoryUrl>https://github.com/tombomeke-ehb/RPGManager</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPGManagerLib\RPGManagerLib.csproj" />
  </ItemGroup>
	<Target Name="UpdateRoadmap" BeforeTargets="Build;Publish" Outputs="$(MSBuildThisFileFullPath).ForceRun">
		<Exec Command="dotnet run --project ../Tools/RoadmapUpdater" />
	</Target>
</Project>
